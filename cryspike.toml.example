# Copy to ./cryspike.toml or ~/.config/cryspike/config.toml.
# CLI flags override environment variables; environment variables override this file.

interval = 5
gpu_threshold = 80.0
cpu_idle = 10.0
window = 5
gpu = -1
exclude_processes = []

# Optional HTTPS incoming webhook (Discord, Slack, or a compatible endpoint).
# webhook_url = "https://discord.com/api/webhooks/..."

# Optional log file. In daemon mode, logs are written here instead of the console.
# log_file = "/var/log/cryspike.log"

daemon = false
